# Spark
SPARK_MASTER=local[*]

# Where the input CSVs live (business.csv, review.csv)
DATA_DIR=file:///home/ubuntu/data/mycsv/

# Kafka. If KAFKA_SERVERS is set, reviews are read from Kafka instead of CSV.
# Leave it empty to fall back to reading review.csv from DATA_DIR.
KAFKA_SERVERS=localhost:9092
REVIEW_TOPIC=reviews
REVIEW_CSV=/home/ubuntu/data/mycsv/review.csv

# Elasticsearch sink
ES_NODES=localhost
ES_PORT=9200
ES_USER=elastic
ES_PASS=changeme

# AWS (only needed if using the S3 helper in config/boto3Config.py)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_SESSION_TOKEN=
